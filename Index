<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registro de asistencia</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <style>
    :root {
      --guinda: #611232;
      --guinda-2: #4a0d26;
      --dorado: #a57f2c;
      --dorado-osc: #86661c;
      --dorado-claro: #e3c98a;
      --fondo: #faf7f2;
      --papel: #ffffff;
      --tinta: #241a1e;
      --tinta-suave: #62565b;
      --linea: #e2d9cc;
      --grafito: #2f2a2c;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; }
    body {
      font-family: 'Atkinson Hyperlegible', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      background: var(--fondo); color: var(--tinta); line-height: 1.45; -webkit-text-size-adjust: 100%;
    }
    .serif { font-family: 'Source Serif 4', Georgia, 'Times New Roman', serif; }

    /* ---------- Cabecera ---------- */
    .cabecera { background: var(--guinda); color: #fff; border-bottom: 4px solid var(--dorado); }
    .cabecera-in { max-width: 560px; margin: 0 auto; padding: 16px; }
    .cabecera h1 { font-family: 'Source Serif 4', Georgia, serif; font-size: 1.4rem; margin: 0; letter-spacing: .2px; }
    .cabecera p { margin: 2px 0 0; color: var(--dorado-claro); font-size: .92rem; }

    main { max-width: 560px; margin: 0 auto; padding: 16px 16px 40px; }
    label { display: block; font-weight: 700; margin-bottom: 6px; color: var(--guinda); }
    select, input[type=text], input[type=password] {
      width: 100%; font: inherit; padding: 12px; color: var(--tinta);
      background: var(--papel); border: 2px solid var(--linea); border-radius: 8px;
    }
    select:focus-visible, input:focus-visible, button:focus-visible { outline: 3px solid var(--dorado); outline-offset: 2px; }
    .tarjeta { background: var(--papel); border: 1px solid var(--linea); border-radius: 12px; padding: 14px; box-shadow: 0 1px 2px rgba(97,18,50,.06); }

    .fila { display: flex; gap: 12px; align-items: end; }
    .fila > div { flex: 1; }
    .contador { text-align: right; min-width: 92px; flex: 0 0 auto !important; }
    .contador strong { display: block; font-family: 'Source Serif 4', Georgia, serif; font-size: 2.1rem; line-height: 1; color: var(--guinda); }
    .contador span { font-size: .82rem; color: var(--tinta-suave); }

    #acceso { display: none; margin-bottom: 16px; border-left: 5px solid var(--dorado); }
    #acceso .fila { margin-top: 8px; }
    #acceso button { flex: 0 0 auto; }

    /* ---------- Escáner ---------- */
    #lector {
      margin: 16px 0 12px; border-radius: 12px; overflow: hidden; background: #1a1015;
      min-height: 260px; border: 3px solid var(--guinda); box-shadow: 0 0 0 3px #fff, 0 0 0 5px var(--dorado);
    }
    #lector video { border-radius: 8px; }
    .botones { display: flex; gap: 10px; }
    .botones + .botones { margin-top: 10px; }
    button {
      font: inherit; font-weight: 700; padding: 12px 16px; border-radius: 8px;
      border: 2px solid var(--guinda); cursor: pointer; flex: 1;
    }
    .primario { background: var(--guinda); color: #fff; }
    .primario:hover:not(:disabled) { background: var(--guinda-2); }
    .secundario { background: #fff; color: var(--guinda); }
    .secundario:hover:not(:disabled) { background: #f6eef1; }
    button:disabled { opacity: .45; cursor: not-allowed; }

    #estado { margin: 14px 0; padding: 11px 14px; background: var(--papel); border: 1px solid var(--linea); border-left: 5px solid var(--dorado); border-radius: 8px; font-weight: 700; }
    #estado.error { border-left-color: var(--guinda); color: var(--guinda); }
    #estado small { display: block; font-weight: 400; color: var(--tinta-suave); margin-top: 2px; }

    .manual small { color: var(--tinta-suave); display: block; margin-top: 4px; }
    h2.seccion { font-family: 'Source Serif 4', Georgia, serif; font-size: 1.05rem; color: var(--guinda); margin: 26px 0 8px; padding-bottom: 6px; border-bottom: 2px solid var(--dorado); }
    ul#recientes { list-style: none; margin: 0; padding: 0; }
    ul#recientes li { display: flex; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--linea); align-items: baseline; }
    ul#recientes .tipo { min-width: 66px; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--dorado-osc); }
    ul#recientes .hora { font-variant-numeric: tabular-nums; color: var(--tinta-suave); min-width: 64px; }
    ul#recientes .folio { min-width: 56px; font-weight: 700; color: var(--guinda); }
    .vacio { color: var(--tinta-suave); padding: 10px 0; }
    .enlace { background: none; border: none; color: var(--tinta-suave); text-decoration: underline; font-weight: 400; padding: 0; flex: 0 0 auto; margin-top: 18px; }

    /* ---------- Ventana flotante ---------- */
    .velo { position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(74, 13, 38, .62); }
    .velo[hidden] { display: none; }
    .modal { width: 100%; max-width: 440px; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,.38); }
    .banda { display: flex; align-items: center; gap: 14px; padding: 18px 20px; color: #fff; background: var(--guinda); border-bottom: 4px solid var(--dorado); }
    .banda h2 { font-family: 'Source Serif 4', Georgia, serif; font-size: 1.7rem; line-height: 1.1; margin: 0; }
    .icono { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; background: #fff; color: var(--guinda); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700; }
    .modal.salida .banda { background: var(--dorado-osc); border-bottom-color: var(--guinda); }
    .modal.salida .icono { color: var(--dorado-osc); }
    .modal.denegado .banda { background: var(--grafito); border-bottom-color: var(--dorado); }
    .modal.denegado .icono { color: var(--grafito); }

    .datos { margin: 0; padding: 18px 20px 4px; display: grid; grid-template-columns: auto 1fr; gap: 10px 16px; align-items: baseline; }
    .datos:empty { display: none; }
    .datos dt { font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--dorado-osc); }
    .datos dd { margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--tinta); overflow-wrap: anywhere; }
    .datos dd.nombre { font-family: 'Source Serif 4', Georgia, serif; font-size: 1.3rem; color: var(--guinda); }
    .mensaje { padding: 14px 20px 0; font-size: 1.05rem; }
    .mensaje:empty { display: none; }
    .pie { margin: 16px 20px 0; padding: 12px 0 16px; border-top: 1px solid var(--linea); display: flex; justify-content: space-between; gap: 12px; align-items: baseline; font-variant-numeric: tabular-nums; }
    .pie:empty { display: none; }
    .pie span { font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--dorado-osc); }
    .pie strong { color: var(--guinda); font-size: 1.05rem; }
    .cuenta { height: 6px; background: #efe6d4; }
    .cuenta i { display: block; height: 100%; width: 100%; background: var(--dorado); }
    @keyframes cuenta { from { width: 100%; } to { width: 0; } }
  </style>
</head>
<body>
<header class="cabecera">
  <div class="cabecera-in">
    <h1>Registro de asistencia</h1>
    <p>Control de entrada y salida por taller</p>
  </div>
</header>

<main>
  <section id="acceso" class="tarjeta">
    <label for="clave">Clave del evento</label>
    <div class="fila">
      <div><input id="clave" type="password" autocomplete="off" placeholder="Te la proporciona el organizador"></div>
      <button id="btnClave" class="primario" type="button">Entrar</button>
    </div>
  </section>

  <div class="fila">
    <div>
      <label for="taller">Taller donde estás registrando</label>
      <select id="taller"><option value="">Cargando talleres…</option></select>
    </div>
    <div class="contador" aria-live="polite">
      <strong id="total">0</strong>
      <span>registrados hoy</span>
    </div>
  </div>

  <div id="lector"></div>
  <div class="botones">
    <button id="btnIniciar" class="primario" type="button">Activar cámara</button>
    <button id="btnDetener" class="secundario" type="button" disabled>Detener</button>
  </div>
  <div class="botones">
    <button id="btnFoto" class="secundario" type="button">Tomar foto del QR</button>
  </div>
  <input id="archivoQR" type="file" accept="image/*" capture="environment" style="display:none">
  <div id="lectorArchivo" style="position:absolute;left:-9999px;top:0;width:1px;height:1px;overflow:hidden"></div>

  <div id="estado" role="status" aria-live="polite">Elige el taller y activa la cámara para escanear.</div>

  <div class="manual">
    <label for="manual">Lector USB o captura manual</label>
    <input id="manual" type="text" autocomplete="off" placeholder="Pega o escanea el contenido y presiona Enter">
    <small>Un lector de códigos USB escribe el contenido del QR aquí y envía Enter automáticamente.</small>
  </div>

  <h2 class="seccion">Últimos movimientos en este taller</h2>
  <ul id="recientes"><li class="vacio">Sin registros todavía.</li></ul>

  <button id="btnCambiarClave" class="enlace" type="button">Cambiar clave</button>
</main>

<!-- Ventana flotante de resultado -->
<div id="velo" class="velo" hidden>
  <div id="modal" class="modal" role="alertdialog" aria-modal="true" aria-labelledby="modalTitulo" aria-describedby="modalMensaje">
    <div class="banda">
      <span id="modalIcono" class="icono" aria-hidden="true">✓</span>
      <h2 id="modalTitulo">Bienvenido(a)</h2>
    </div>
    <dl id="modalDatos" class="datos"></dl>
    <div id="modalMensaje" class="mensaje"></div>
    <div id="modalPie" class="pie"></div>
    <div class="cuenta"><i id="modalBarra"></i></div>
  </div>
</div>

<script>
  // ================== CONFIGURACIÓN ==================
  // URL de la aplicación web de Apps Script (termina en /exec)
  const API_URL = 'https://script.google.com/macros/s/AKfycbweCsnDg6bbKccmMsTxI5ldkArRUaEok2kRl-h65jpIHs2_dKlQxzOQsIeUYyddJ8TD/exec';
  // Tiempo que permanece visible la ventana de resultado
  const DURACION_VENTANA_MS = 4000;
  // ====================================================

  const selTaller = document.getElementById('taller');
  const btnIniciar = document.getElementById('btnIniciar');
  const btnDetener = document.getElementById('btnDetener');
  const estado = document.getElementById('estado');
  const inputManual = document.getElementById('manual');
  const seccionAcceso = document.getElementById('acceso');
  const velo = document.getElementById('velo');

  let clave = leerLocal('claveEvento') || '';
  let escaner = null;
  let ocupado = false;
  let ultimoTexto = '';
  let ultimoMomento = 0;
  let audioCtx = null;
  let pantallaActiva = null;
  let temporizadorVentana = null;

  // ---------- API ----------
  function manejar(resp) {
    return resp.json().then(function (d) {
      if (!d.ok) throw new Error(d.mensaje || 'Error del servidor.');
      return d;
    });
  }
  function apiGet(action, extra) {
    const q = new URLSearchParams(Object.assign({ action: action, clave: clave }, extra || {}));
    return fetch(API_URL + '?' + q.toString()).then(manejar);
  }
  function apiPost(cuerpo) {
    // text/plain evita la petición previa (preflight) que Apps Script no responde
    return fetch(API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(Object.assign({ clave: clave }, cuerpo))
    }).then(manejar);
  }
  function textoError(e) {
    if (/clave/i.test(e.message)) { pedirClave(); return 'Clave incorrecta. Vuelve a escribirla.'; }
    if (/fetch|network|load failed/i.test(e.message)) {
      return 'Sin conexión con el servidor. Revisa tu internet.';
    }
    return e.message;
  }

  // ---------- Acceso ----------
  function pedirClave() { seccionAcceso.style.display = 'block'; }
  document.getElementById('btnClave').addEventListener('click', function () {
    const v = document.getElementById('clave').value.trim();
    if (!v) return;
    clave = v; guardarLocal('claveEvento', v);
    seccionAcceso.style.display = 'none';
    cargarTalleres();
  });
  document.getElementById('btnCambiarClave').addEventListener('click', function () {
    document.getElementById('clave').value = '';
    pedirClave();
  });

  // ---------- Talleres ----------
  function cargarTalleres() {
    apiGet('talleres').then(function (d) {
      selTaller.innerHTML = '<option value="">Selecciona un taller…</option>' +
        d.talleres.map(function (t) { return '<option>' + esc(t) + '</option>'; }).join('');
      const guardado = leerLocal('tallerActual');
      if (guardado && d.talleres.indexOf(guardado) > -1) { selTaller.value = guardado; cargarResumen(); }
    }).catch(function (e) {
      selTaller.innerHTML = '<option value="">No se pudo cargar</option>';
      poner('No se pudieron cargar los talleres', textoError(e), true);
    });
  }
  selTaller.addEventListener('change', function () {
    guardarLocal('tallerActual', selTaller.value);
    cargarResumen();
  });
  if (!clave) pedirClave(); else cargarTalleres();

  // ---------- Cámara en vivo (escaneo continuo) ----------
  btnIniciar.addEventListener('click', function () {
    if (!selTaller.value) { poner('Primero elige el taller', '', true); return; }
    preparaAudio();
    escaner = new Html5Qrcode('lector', {
      formatsToSupport: [Html5QrcodeSupportedFormats.QR_CODE],
      experimentalFeatures: { useBarCodeDetectorIfSupported: true },
      verbose: false
    });
    escaner.start(
      { facingMode: 'environment' },
      {
        fps: 12,
        qrbox: function (w, h) { const s = Math.floor(Math.min(w, h) * 0.75); return { width: s, height: s }; }
      },
      alLeer,
      function () {}
    ).then(function () {
      btnIniciar.disabled = true; btnDetener.disabled = false;
      poner('Cámara activa', 'Muestra un código QR tras otro.');
      mantenerPantalla();
    }).catch(function (err) {
      poner('No se pudo activar la cámara',
        'Toca «Permitir» cuando el navegador pida acceso. Si lo negaste, actívalo en los permisos del sitio (candado junto a la dirección). Mientras, usa «Tomar foto del QR». Detalle: ' + err, true);
    });
  });
  btnDetener.addEventListener('click', detener);

  function detener() {
    if (!escaner) return;
    escaner.stop().then(function () {
      escaner.clear();
      btnIniciar.disabled = false; btnDetener.disabled = true;
      if (pantallaActiva) { pantallaActiva.release().catch(function () {}); pantallaActiva = null; }
      poner('Cámara detenida', '');
    }).catch(function () {});
  }

  function alLeer(texto) {
    if (ocupado) return;
    // Evita reenviar el mismo QR mientras sigue frente a la cámara tras cerrarse la ventana
    if (texto === ultimoTexto && Date.now() - ultimoMomento < 5000) return;
    ultimoTexto = texto;
    enviar(texto);
  }

  function mantenerPantalla() {
    if (!('wakeLock' in navigator)) return;
    navigator.wakeLock.request('screen').then(function (l) { pantallaActiva = l; }).catch(function () {});
  }
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'visible' && escaner && !btnDetener.disabled) mantenerPantalla();
  });

  // ---------- Foto del QR (respaldo) ----------
  const btnFoto = document.getElementById('btnFoto');
  const inputArchivo = document.getElementById('archivoQR');
  btnFoto.addEventListener('click', function () {
    if (!selTaller.value) { poner('Primero elige el taller', '', true); return; }
    inputArchivo.value = '';
    inputArchivo.click();
  });
  inputArchivo.addEventListener('change', function () {
    const archivo = inputArchivo.files && inputArchivo.files[0];
    if (!archivo || ocupado) return;
    poner('Leyendo la foto…', '');
    const lector = new Html5Qrcode('lectorArchivo');
    lector.scanFile(archivo, false)
      .then(function (texto) { lector.clear(); enviar(texto); })
      .catch(function () {
        poner('No se detectó ningún QR en la foto', 'Acércate, encuadra el código completo y con buena luz, e inténtalo de nuevo.', true);
      });
  });

  // ---------- Captura manual / lector USB ----------
  inputManual.addEventListener('keydown', function (ev) {
    if (ev.key !== 'Enter') return;
    const v = inputManual.value.trim();
    if (!v || ocupado) return;
    inputManual.value = '';
    enviar(v);
  });

  // ---------- Envío ----------
  function enviar(texto) {
    if (!selTaller.value) { poner('Primero elige el taller', '', true); return; }
    ocupado = true;
    poner('Buscando folio…', '');
    apiPost({ action: 'registrar', taller: selTaller.value, qr: texto })
      .then(function (d) { presentar(d.resultado); })
      .catch(function (e) {
        presentar({ estado: 'error', mensaje: textoError(e) });
        ultimoTexto = ''; // permite reintentar de inmediato el mismo QR
      });
  }

  /** Decide el aspecto de la ventana según el resultado. */
  function presentar(r) {
    let cfg;
    if (r.estado === 'ok' && r.tipo === 'entrada') {
      cfg = { clase: 'entrada', icono: '✓', titulo: 'Bienvenido(a)', mensaje: '', pie: ['Llegada', r.fecha + ' · ' + r.hora], tono: [880, 0.14], vib: 120 };
    } else if (r.estado === 'ok') {
      cfg = { clase: 'salida', icono: '✓', titulo: 'Salida registrada', mensaje: 'Gracias por su asistencia.', pie: ['Salida', r.fecha + ' · ' + r.hora], tono: [660, 0.14], vib: 120 };
    } else if (r.estado === 'denegado') {
      cfg = { clase: 'denegado', icono: '✕', titulo: 'Registro no permitido', mensaje: r.mensaje, pie: r.fecha ? ['Intento', r.fecha + ' · ' + r.hora] : null, tono: [300, 0.35], vib: [80, 60, 80] };
    } else if (r.estado === 'noencontrado') {
      cfg = { clase: 'denegado', icono: '?', titulo: 'Folio no encontrado', mensaje: r.mensaje, pie: r.fecha ? ['Consulta', r.fecha + ' · ' + r.hora] : null, tono: [300, 0.35], vib: [200, 80, 200] };
    } else {
      cfg = { clase: 'denegado', icono: '!', titulo: 'No se pudo registrar', mensaje: r.mensaje || 'Error desconocido.', pie: null, tono: [300, 0.35], vib: [200, 80, 200] };
    }

    const filas = [];
    if (r.folio) filas.push(['Folio', r.folio, '']);
    if (r.rfc) filas.push(['RFC', r.rfc, '']);
    if (r.nombre) filas.push(['Nombre completo', r.nombre, 'nombre']);
    abrirVentana(cfg, filas);
    if (r.estado === 'ok') cargarResumen();
  }

  function abrirVentana(cfg, filas) {
    document.getElementById('modal').className = 'modal ' + cfg.clase;
    document.getElementById('modalIcono').textContent = cfg.icono;
    document.getElementById('modalTitulo').textContent = cfg.titulo;
    document.getElementById('modalDatos').innerHTML = filas.map(function (f) {
      return '<dt>' + esc(f[0]) + '</dt><dd class="' + f[2] + '">' + esc(f[1]) + '</dd>';
    }).join('');
    document.getElementById('modalMensaje').textContent = cfg.mensaje || '';
    document.getElementById('modalPie').innerHTML = cfg.pie
      ? '<span>' + esc(cfg.pie[0]) + '</span><strong>' + esc(cfg.pie[1]) + '</strong>' : '';

    const barra = document.getElementById('modalBarra');
    barra.style.animation = 'none';
    void barra.offsetWidth; // reinicia la animación
    barra.style.animation = 'cuenta ' + (DURACION_VENTANA_MS / 1000) + 's linear forwards';

    velo.hidden = false;
    sonar(cfg.tono[0], cfg.tono[1]);
    vibrar(cfg.vib);

    clearTimeout(temporizadorVentana);
    temporizadorVentana = setTimeout(cerrarVentana, DURACION_VENTANA_MS);
  }

  function cerrarVentana() {
    velo.hidden = true;
    ultimoMomento = Date.now();
    ocupado = false;
    poner(escaner && !btnDetener.disabled ? 'Cámara activa' : 'Listo', escaner && !btnDetener.disabled ? 'Muestra el siguiente código QR.' : '');
  }

  function cargarResumen() {
    const taller = selTaller.value;
    const ul = document.getElementById('recientes');
    if (!taller) { document.getElementById('total').textContent = '0'; return; }
    apiGet('resumen', { taller: taller }).then(function (d) {
      const r = d.resumen;
      document.getElementById('total').textContent = r.total;
      ul.innerHTML = r.recientes.length
        ? r.recientes.map(function (x) {
            return '<li><span class="tipo">' + esc(x.tipo) + '</span><span class="hora">' + esc(x.hora) +
                   '</span><span class="folio">' + esc(x.folio) + '</span><span>' + esc(x.nombre) + '</span></li>';
          }).join('')
        : '<li class="vacio">Sin registros todavía.</li>';
    }).catch(function (e) { poner('No se pudo leer la hoja del taller', textoError(e), true); });
  }

  // ---------- Utilidades ----------
  function poner(titulo, detalle, esError) {
    estado.className = esError ? 'error' : '';
    estado.innerHTML = esc(titulo) + (detalle ? '<small>' + esc(detalle) + '</small>' : '');
  }
  function preparaAudio() {
    try { audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {}
  }
  function sonar(freq, dur) {
    try {
      if (!audioCtx) return;
      const o = audioCtx.createOscillator(), g = audioCtx.createGain();
      o.frequency.value = freq; g.gain.value = 0.08;
      o.connect(g); g.connect(audioCtx.destination);
      o.start(); o.stop(audioCtx.currentTime + dur);
    } catch (e) {}
  }
  function vibrar(p) { if (navigator.vibrate) navigator.vibrate(p); }
  function leerLocal(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function guardarLocal(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
</script>
